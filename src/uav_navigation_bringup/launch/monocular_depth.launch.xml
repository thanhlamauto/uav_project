<?xml version="1.0"?>
<launch>
  <arg name="params_file" default="$(find-pkg-share uav_navigation_bringup)/config/runtime.yaml"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="model_file" default="/models/depth_fp16.plan"/>
  <arg name="depth_backend" default="auto"/>
  <arg name="node_package" default="uav_navigation_ros"/>
  <arg name="node_executable" default="monocular_depth_node"/>
  <node pkg="$(var node_package)" exec="$(var node_executable)" name="monocular_depth_cpp" output="screen">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="model_path" value="$(var model_file)"/>
    <param name="backend" value="$(var depth_backend)"/>
  </node>
</launch>
