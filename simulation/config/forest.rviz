Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 28; 32; 40
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane: XY
    Plane Cell Count: 60
    Color: 80; 85; 95
    Alpha: 0.35
  - Class: rviz_default_plugins/Path
    Name: A* global path (yellow)
    Enabled: true
    Topic:
      Value: /planning/global_path
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color: 255; 210; 0
    Alpha: 1
    Line Style: Billboards
    Line Width: 0.065
    Buffer Length: 1
    Pose Style: None
  - Class: rviz_default_plugins/Path
    Name: MPPI prediction (cyan)
    Enabled: true
    Topic:
      Value: /planning/mppi/predicted_path
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color: 0; 230; 255
    Alpha: 1
    Line Style: Billboards
    Line Width: 0.065
    Buffer Length: 1
    Pose Style: None
  - Class: rviz_default_plugins/Path
    Name: Actual flight (white)
    Enabled: true
    Topic:
      Value: /visualization/actual_path
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color: 255; 255; 255
    Alpha: 1
    Line Style: Billboards
    Line Width: 0.065
    Buffer Length: 1
    Pose Style: None
  - Class: rviz_default_plugins/MarkerArray
    Name: Forest geometry + goal (reference)
    Enabled: true
    Topic:
      Value: /visualization/forest
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Live status / reason for holding
    Enabled: true
    Topic:
      Value: /visualization/status
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointCloud2
    Name: Depth predicted obstacles (orange)
    Enabled: true
    Topic:
      Value: /perception/obstacles_camera
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 255; 125; 35
    Position Transformer: XYZ
    Alpha: 0.85
    Style: Points
    Size (Pixels): 3
    Size (m): 0.04
    Decay Time: 0.3
    Use Fixed Frame: true
  - Class: rviz_default_plugins/Odometry
    Name: UAV pose
    Enabled: true
    Topic:
      Value: /localization/odometry
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Keep: 1
    Shape:
      Value: Arrow
      Color: 255; 255; 255
      Alpha: 1
      Shaft Length: 0.7
      Shaft Radius: 0.07
      Head Length: 0.3
      Head Radius: 0.15
  - Class: rviz_default_plugins/Image
    Name: RGB camera (visualization 2 Hz)
    Enabled: true
    Topic:
      Value: /camera/image_rect_color
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 38
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 10
        Y: 2
        Z: 3
      Target Frame: map
Window Geometry:
  Width: 1440
  Height: 900
