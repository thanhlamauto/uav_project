# Stable receiver compiler dependencies; independent of navigation source changes.
ARG BUILD_BASE=uav-navigation:humble
FROM ${BUILD_BASE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=20 update && \
    apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=20 \
      install -y --no-install-recommends \
      build-essential cmake python3-colcon-common-extensions libjpeg-dev \
      ros-humble-ament-cmake ros-humble-rosgraph-msgs \
    && rm -rf /var/lib/apt/lists/*
