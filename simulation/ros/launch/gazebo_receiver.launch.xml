<?xml version="1.0"?>
<launch>
  <arg name="bind_address" default="192.168.55.1"/>
  <arg name="port" default="7447"/>
  <arg name="node_package" default="uav_simulation"/>
  <arg name="node_executable" default="gazebo_receiver"/>
  <node pkg="$(var node_package)" exec="$(var node_executable)" name="gazebo_receiver" output="screen">
    <param name="bind_address" value="$(var bind_address)"/>
    <param name="port" value="$(var port)"/>
  </node>
</launch>
